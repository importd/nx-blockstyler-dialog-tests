{
  "title": "baseDialog regression",
  "dll": "baseDialog_test.dll",
  "part": "D:/Program Files/Siemens/NX 10.0/UGII/drafting_welcome/sample_parts/flange.prt",
  "timeout_ms": 8000,
  "cases": [
    {
      "name": "defaults",
      "title": "默认值 + 钩子确实跑了",
      "expect": {
        "shown": 1,
        "hook_ran": 1,
        "selection0": 0,
        "enum0": 0,
        "linear_dim0": 0.0
      }
    },
    {
      "name": "set_enum",
      "title": "枚举切到第 3 项",
      "set": {"enum0": 2},
      "expect": {"enum0": 2}
    },
    {
      "name": "set_dim",
      "title": "数值写入 12.5",
      "set": {"linear_dim0": 12.5},
      "expect": {"linear_dim0": 12.5}
    },
    {
      "name": "select_body",
      "title": "选工作零件的第一个实体",
      "set": {"selection0": "first_body"},
      "expect": {"selection0": 1}
    },
    {
      "name": "apply",
      "title": "注入后调用 apply_cb",
      "set": {"enum0": 1, "linear_dim0": 3.0},
      "apply": true,
      "expect": {"apply_rc": 0, "enum0": 1, "linear_dim0": 3.0}
    },
    {
      "name": "bad_enum",
      "title": "枚举越界必须留下 error 且仍关窗",
      "allow_invalid": true,
      "set": {"enum0": 99},
      "expect": {"shown": 1, "error_contains": "enum0"}
    }
  ]
}
